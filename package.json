{
  "name": "mdiff",
  "displayName": "Markdown Rendered Diff",
  "description": "Shows the diff of a Markdown or Quarto file as rendered output, next to the source diff.",
  "version": "0.5.0",
  "publisher": "KonstantinSofeikov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sofeikov/mdiff.git"
  },
  "homepage": "https://github.com/sofeikov/mdiff#readme",
  "bugs": {
    "url": "https://github.com/sofeikov/mdiff/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdiff.showRenderedDiff",
        "title": "Show Rendered Diff",
        "category": "Markdown Rendered Diff",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdiff.openChange",
        "title": "Open Changes with Rendered Diff",
        "category": "Markdown Rendered Diff"
      },
      {
        "command": "mdiff.compareWithHead",
        "title": "Rendered Diff with HEAD",
        "category": "Markdown Rendered Diff"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdiff.showRenderedDiff",
          "when": "isInDiffEditor && (resourceLangId == markdown || resourceLangId == quarto || resourceExtname == .qmd)",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "mdiff.compareWithHead",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mkdn|qmd)$/i",
          "group": "mdiff"
        }
      ],
      "explorer/context": [
        {
          "command": "mdiff.compareWithHead",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mkdn|qmd)$/i",
          "group": "3_compare"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "mdiff.openChange",
          "when": "scmProvider == git && resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mkdn|qmd)$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdiff.openChange",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Rendered Diff",
      "properties": {
        "mdiff.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "When a diff of a Markdown or Quarto file opens (for example from the Source Control view), also open the rendered diff next to it."
        },
        "mdiff.formulaDiff": {
          "type": "string",
          "enum": [
            "parts",
            "whole"
          ],
          "enumDescriptions": [
            "Mark only the changed parts of a formula, for example one subscript or one added term.",
            "Mark the whole formula when any part of it changes."
          ],
          "default": "parts",
          "description": "How a changed formula is marked in the rendered diff."
        },
        "mdiff.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Keep the scroll position of the rendered diff and of the source diff editor in step."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies -o mdiff.vsix",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "bench": "node --expose-gc scripts/bench.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "diff": "9.0.0",
    "js-yaml": "4.3.2",
    "katex": "0.19.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "$katex"
  },
  "keywords": [
    "markdown",
    "diff",
    "git",
    "katex",
    "math",
    "quarto",
    "review"
  ]
}
